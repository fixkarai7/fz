Step 4 — Queries
1.Retrieve all employees belonging to Sales

{
"selector": { "department": "Sales"
}
}

2.Designation is Manager OR salary > 50000

{
"selector": {
"$or": [
{
"designation": "Manager"
},
{
"salary": { "$gt": 50000
}
}
]
}
}

3.Salary > 50000 AND salary < 80000

{
"selector": {
"salary": {
"$gt": 50000,
"$lt": 80000
}
}
}

4.Display all employees in descending salary order

{
"selector": {}, "sort": [
{
"salary": "desc"
}
]
}

5.Marketing employees in descending salary order

{
"selector": {
"department": "Marketing"
},
"sort": [
{
"salary": "desc"
}
]
}
