Write a program to find 
a. Density
b. Degree 
c. Reciprocity
d. Transitivity Index 
e. Transitivity Census 

#undirected
library("igraph")

g <- graph_from_literal(
  1-2, 1-3, 2-3, 2-4, 3-5,
  4-5, 4-6, 4-7, 5-6, 6-7
)

plot(g)

n <- vcount(g)
e <- ecount(g)

density <- e / (n * (n - 1) / 2)
density

degree(g)

reciprocity(g)

dyad_census(g)

transitivity(g)

transitivity(g, type = "local")

#directed graph

library("igraph")

g <- graph_from_literal(
  1-+2, 1-+3, 2++3,
  3-+5, 3+-4, 4++5
)

plot(g)

n <- vcount(g)
e <- ecount(g)

density <- e / (n * (n - 1))
density
degree(g) 
reciprocity(g)
dyad_census(g)
transitivity(g) 
transitivity(g,type = "local") 
