4.Display all products

SELECT * FROM products;

Query 1 — Electronics

SELECT * FROM products 
WHERE category = 'electronics';

Query 2 — Clothing with price < 1000

SELECT * FROM products 
WHERE category = 'clothing' 
AND price < 1000;

Query 3 — Clothing sorted by price

SELECT * FROM products 
WHERE category = 'clothing' 
ORDER BY price ASC;

Query 4 — Electronics with stock > 100

SELECT * FROM products 
WHERE category = 'electronics' 
AND stock > 100
ALLOW FILTERING;
